<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup exe for the patched EffectCraft build. WiX Burn wraps the upstream per-machine MSI
  (packaging/windows/effectcraft.wxs in storytold/effectcraft). Built by release.yml:

    wix build effectcraft-bundle.wxs -ext WixToolset.Bal.wixext -arch x64 -d MsiPath=... -o Setup.exe
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
      Name="EffectCraft"
      Manufacturer="Devmaroli"
      Version="0.11.2.0"
      UpgradeCode="C4E8B2A1-0112-4F60-9C3E-EC0DEC11B2A1"
      Compressed="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseUrl="https://github.com/storytold/effectcraft/blob/v0.11.1/LICENSE-MIT"
          Theme="hyperlinkLicense" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="EffectCraft" SourceFile="$(var.MsiPath)" Visible="yes" DisplayInternalUI="yes" />
    </Chain>
  </Bundle>
</Wix>
