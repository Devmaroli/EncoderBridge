      VALUE "OriginalFilename", "EncoderBridge-Setup-x64.exe"
      VALUE "ProductName", "EncoderBridge"
      VALUE "ProductVersion", "0.6.0-beta"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
